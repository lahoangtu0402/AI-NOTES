---
/** Hình minh họa hero: bàn học với laptop, chồng sách, cây nhỏ và cốc trà (phong cách clay). */
---

<svg
  class="hero-desk"
  viewBox="0 0 720 480"
  role="img"
  aria-label="Minh họa: laptop hiển thị biểu đồ, chồng sách, cây nhỏ và cốc trà trên bàn học"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="hd-wood" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#D9A66B"></stop>
      <stop offset="1" stop-color="#B9803F"></stop>
    </linearGradient>
    <linearGradient id="hd-lap" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#EDE6DA"></stop>
      <stop offset="1" stop-color="#C9BFAF"></stop>
    </linearGradient>
    <linearGradient id="hd-screen" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#2B3A4A"></stop>
      <stop offset="1" stop-color="#18222D"></stop>
    </linearGradient>
    <linearGradient id="hd-b1" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#6FB38A"></stop>
      <stop offset="1" stop-color="#4C8F68"></stop>
    </linearGradient>
    <linearGradient id="hd-b2" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#F0B35C"></stop>
      <stop offset="1" stop-color="#D4912F"></stop>
    </linearGradient>
    <linearGradient id="hd-b3" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#8FA9E0"></stop>
      <stop offset="1" stop-color="#6A86C4"></stop>
    </linearGradient>
    <linearGradient id="hd-pot" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#F2A27C"></stop>
      <stop offset="1" stop-color="#D2744C"></stop>
    </linearGradient>
    <radialGradient id="hd-leaf" cx="0.3" cy="0.25" r="0.9">
      <stop offset="0" stop-color="#9AD39A"></stop>
      <stop offset="1" stop-color="#4E9158"></stop>
    </radialGradient>
    <filter id="hd-shadow" x="-20%" y="-20%" width="140%" height="150%">
      <feDropShadow dx="0" dy="6" stdDeviation="5" flood-color="#3a2410" flood-opacity="0.28"></feDropShadow>
    </filter>
    <filter id="hd-soft" x="-20%" y="-20%" width="140%" height="150%">
      <feDropShadow dx="0" dy="3" stdDeviation="2.5" flood-color="#000" flood-opacity="0.22"></feDropShadow>
    </filter>
  </defs>

  <!-- ánh sáng nền -->
  <ellipse cx="360" cy="250" rx="300" ry="190" fill="#fff" opacity="0.12"></ellipse>

  <!-- mạng nơ-ron lơ lửng phía sau -->
  <g opacity="0.9" filter="url(#hd-soft)">
    <path d="M110 120 L180 80 M110 120 L170 170 M180 80 L250 110 M170 170 L250 110 M250 110 L320 70" stroke="#FFF4E0" stroke-width="5" stroke-linecap="round" fill="none"></path>
    <circle cx="110" cy="120" r="15" fill="#F0B35C"></circle>
    <circle cx="180" cy="80" r="12" fill="#FFF4E0"></circle>
    <circle cx="170" cy="170" r="13" fill="#FFF4E0"></circle>
    <circle cx="250" cy="110" r="16" fill="#6FB38A"></circle>
    <circle cx="320" cy="70" r="11" fill="#FFF4E0"></circle>
    <circle cx="106" cy="115" r="4.5" fill="#fff" opacity="0.7"></circle>
    <circle cx="246" cy="105" r="4.8" fill="#fff" opacity="0.6"></circle>
  </g>

  <!-- mặt bàn -->
  <ellipse cx="360" cy="428" rx="330" ry="26" fill="#000" opacity="0.14"></ellipse>
  <g filter="url(#hd-shadow)">
    <rect x="40" y="372" width="640" height="52" rx="26" fill="url(#hd-wood)"></rect>
    <rect x="52" y="376" width="616" height="10" rx="5" fill="#fff" opacity="0.22"></rect>
  </g>

  <!-- laptop -->
  <g filter="url(#hd-shadow)">
    <rect x="190" y="360" width="290" height="22" rx="11" fill="url(#hd-lap)"></rect>
    <rect x="200" y="362" width="270" height="5" rx="2.5" fill="#fff" opacity="0.6"></rect>
    <rect x="212" y="170" width="246" height="196" rx="18" fill="url(#hd-lap)"></rect>
    <rect x="224" y="182" width="222" height="170" rx="10" fill="url(#hd-screen)"></rect>
  </g>
  <!-- nội dung màn hình: biểu đồ + đồ thị -->
  <g>
    <rect x="238" y="198" width="36" height="8" rx="4" fill="#F0B35C"></rect>
    <rect x="280" y="198" width="22" height="8" rx="4" fill="#6FB38A" opacity="0.9"></rect>
    <rect x="238" y="290" width="22" height="48" rx="6" fill="#8FA9E0"></rect>
    <rect x="266" y="270" width="22" height="68" rx="6" fill="#6FB38A"></rect>
    <rect x="294" y="300" width="22" height="38" rx="6" fill="#8FA9E0"></rect>
    <rect x="322" y="250" width="22" height="88" rx="6" fill="#F0B35C"></rect>
    <path d="M356 320 C 372 280, 384 300, 398 250 S 426 236, 434 214" stroke="#FFF4E0" stroke-width="4" stroke-linecap="round" fill="none"></path>
    <circle cx="398" cy="250" r="6" fill="#FFF4E0"></circle>
    <circle cx="434" cy="214" r="7" fill="#F0B35C"></circle>
    <ellipse cx="260" cy="214" rx="10" ry="3" fill="#fff" opacity="0.25" transform="rotate(-20 260 214)"></ellipse>
  </g>

  <!-- chồng sách -->
  <g filter="url(#hd-shadow)">
    <rect x="498" y="338" width="148" height="34" rx="12" fill="url(#hd-b1)"></rect>
    <rect x="510" y="347" width="124" height="6" rx="3" fill="#fff" opacity="0.5"></rect>
    <rect x="512" y="304" width="124" height="34" rx="12" fill="url(#hd-b2)"></rect>
    <rect x="524" y="313" width="100" height="6" rx="3" fill="#fff" opacity="0.5"></rect>
    <rect x="504" y="270" width="136" height="34" rx="12" fill="url(#hd-b3)"></rect>
    <rect x="516" y="279" width="112" height="6" rx="3" fill="#fff" opacity="0.5"></rect>
  </g>

  <!-- cây nhỏ -->
  <g filter="url(#hd-shadow)">
    <path d="M538 270 C 520 236, 540 214, 546 196 C 560 220, 572 244, 538 270 Z" fill="url(#hd-leaf)"></path>
    <path d="M556 270 C 574 240, 600 232, 612 216 C 612 246, 596 268, 556 270 Z" fill="url(#hd-leaf)"></path>
    <path d="M570 272 C 560 252, 566 236, 578 224 C 588 244, 590 262, 570 272 Z" fill="#5FA46A"></path>
  </g>

  <!-- cốc trà -->
  <g filter="url(#hd-shadow)">
    <path d="M118 322 H190 V352 C 190 366, 178 374, 154 374 C 130 374, 118 366, 118 352 Z" fill="#FFF4E0"></path>
    <path d="M190 332 C 214 330, 214 360, 188 360" stroke="#FFF4E0" stroke-width="9" stroke-linecap="round" fill="none"></path>
    <ellipse cx="154" cy="322" rx="36" ry="7" fill="#C9833B"></ellipse>
    <ellipse cx="154" cy="321" rx="30" ry="4.5" fill="#E2A55A" opacity="0.8"></ellipse>
    <rect x="128" y="334" width="9" height="28" rx="4.5" fill="#fff" opacity="0.65"></rect>
    <path d="M142 306 C 134 296, 150 290, 142 278 M162 308 C 154 298, 170 292, 162 280" stroke="#fff" stroke-opacity="0.55" stroke-width="4" stroke-linecap="round" fill="none"></path>
  </g>
</svg>

<style>
  .hero-desk {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
