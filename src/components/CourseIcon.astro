---
/**
 * Icon kiểu "clay" cho từng môn học, vẽ bằng SVG (không cần file ảnh).
 * Mỗi icon gồm một viên gạch màu nền và một biểu tượng nổi khối bên trên.
 * Muốn thêm icon mới: thêm một khối <g> bên dưới và thêm tên vào enum `icon`
 * trong src/content.config.ts.
 */
interface Props {
  name: 'vision' | 'network' | 'algorithm' | 'concept' | 'research' | 'math' | 'code' | 'data';
  size?: number;
  label?: string;
}
const { name, size = 56, label } = Astro.props;

// Màu nền (sáng → đậm) cho từng icon
const tiles = {
  vision: ['#9BD6E0', '#4FA3B8'],
  network: ['#F3C3A0', '#DE8F5F'],
  algorithm: ['#F6D77E', '#D9A12B'],
  concept: ['#C9B6E8', '#8F73C4'],
  research: ['#B6DDA8', '#6BA55E'],
  math: ['#F2B6B6', '#D26C6C'],
  code: ['#A9C4F0', '#5F86CC'],
  data: ['#F0CF9A', '#C98F3C'],
} as const;
const [c1, c2] = tiles[name];
const id = `ci-${name}`;
---

<svg
  class="course-icon"
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id={`${id}-tile`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color={c1}></stop>
      <stop offset="1" stop-color={c2}></stop>
    </linearGradient>
    <radialGradient id={`${id}-ball`} cx="0.35" cy="0.3" r="0.8">
      <stop offset="0" stop-color="#ffffff"></stop>
      <stop offset="0.45" stop-color="#FFF4E0"></stop>
      <stop offset="1" stop-color="#E6CFA8"></stop>
    </radialGradient>
    <radialGradient id={`${id}-ink`} cx="0.35" cy="0.3" r="0.9">
      <stop offset="0" stop-color="#6b5a4a"></stop>
      <stop offset="1" stop-color="#2d231b"></stop>
    </radialGradient>
    <filter id={`${id}-soft`} x="-20%" y="-20%" width="140%" height="150%">
      <feDropShadow dx="0" dy="1.6" stdDeviation="1.4" flood-color="#000" flood-opacity="0.22"></feDropShadow>
    </filter>
  </defs>

  <!-- viên gạch nền -->
  <rect x="3" y="3" width="58" height="58" rx="18" fill={`url(#${id}-tile)`}></rect>
  <rect x="3" y="3" width="58" height="58" rx="18" fill="none" stroke="#fff" stroke-opacity="0.35" stroke-width="1.2"></rect>
  <ellipse cx="22" cy="12" rx="15" ry="6" fill="#fff" opacity="0.28"></ellipse>

  <g filter={`url(#${id}-soft)`}>
    {name === 'vision' && (
      <>
        <path d="M8 33 C 17 19, 47 19, 56 33 C 47 47, 17 47, 8 33 Z" fill="#FFFDF8"></path>
        <circle cx="32" cy="33" r="11" fill="#2F7F95"></circle>
        <circle cx="32" cy="33" r="11" fill={`url(#${id}-ink)`} opacity="0.18"></circle>
        <circle cx="32" cy="33" r="5.2" fill="#1d2a30"></circle>
        <circle cx="28.6" cy="29.2" r="2.6" fill="#fff"></circle>
        <circle cx="35.5" cy="36.5" r="1.2" fill="#fff" opacity="0.8"></circle>
      </>
    )}

    {name === 'network' && (
      <>
        <path d="M20 24 L44 20 M20 24 L30 46 M44 20 L30 46 M44 20 L50 42" stroke="#FFF4E0" stroke-width="3" stroke-linecap="round" fill="none"></path>
        <circle cx="20" cy="24" r="8" fill="#FFF4E0"></circle>
        <circle cx="44" cy="20" r="7" fill="#FFF4E0"></circle>
        <circle cx="30" cy="46" r="8.5" fill="#FFF4E0"></circle>
        <circle cx="50" cy="42" r="5.5" fill="#FFF4E0"></circle>
        <circle cx="20" cy="24" r="8" fill={`url(#${id}-ball)`}></circle>
        <circle cx="44" cy="20" r="7" fill={`url(#${id}-ball)`}></circle>
        <circle cx="30" cy="46" r="8.5" fill="#B5502B"></circle>
        <circle cx="27.5" cy="43.5" r="2.4" fill="#fff" opacity="0.6"></circle>
        <circle cx="50" cy="42" r="5.5" fill={`url(#${id}-ball)`}></circle>
      </>
    )}

    {name === 'algorithm' && (
      <>
        <path d="M32 20 L18 42 M32 20 L46 42" stroke="#FFF8E6" stroke-width="3.2" stroke-linecap="round" fill="none"></path>
        <circle cx="32" cy="19" r="8.5" fill={`url(#${id}-ball)`}></circle>
        <circle cx="17" cy="43" r="7.5" fill={`url(#${id}-ball)`}></circle>
        <circle cx="47" cy="43" r="7.5" fill="#8A5A00"></circle>
        <circle cx="44.8" cy="40.6" r="2" fill="#fff" opacity="0.55"></circle>
      </>
    )}

    {name === 'concept' && (
      <>
        <path d="M32 10 C 20 10, 14 19, 14 27 C 14 34, 19 37, 22 42 L 42 42 C 45 37, 50 34, 50 27 C 50 19, 44 10, 32 10 Z" fill={`url(#${id}-ball)`}></path>
        <rect x="23" y="43" width="18" height="6.5" rx="3.2" fill="#6F5A91"></rect>
        <rect x="26" y="50" width="12" height="5" rx="2.5" fill="#5A4779"></rect>
        <path d="M27 36 L27 27 L32 31 L37 27 L37 36" stroke="#C9A54A" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
        <ellipse cx="25" cy="18" rx="3.5" ry="5" fill="#fff" opacity="0.7" transform="rotate(25 25 18)"></ellipse>
      </>
    )}

    {name === 'research' && (
      <>
        <rect x="11" y="11" width="31" height="40" rx="5" fill={`url(#${id}-ball)`}></rect>
        <path d="M17 21 H36 M17 28 H36 M17 35 H28" stroke="#9CB58F" stroke-width="3" stroke-linecap="round"></path>
        <circle cx="42" cy="38" r="10" fill="#EAF6E4" fill-opacity="0.85" stroke="#2F5A2A" stroke-width="4"></circle>
        <path d="M49.5 45.5 L56 52" stroke="#2F5A2A" stroke-width="5.5" stroke-linecap="round"></path>
        <ellipse cx="39" cy="34.5" rx="3" ry="2" fill="#fff" opacity="0.9" transform="rotate(-35 39 34.5)"></ellipse>
      </>
    )}

    {name === 'math' && (
      <>
        <path d="M13 50 L13 14 L47 50 Z" fill={`url(#${id}-ball)`} stroke="#FFF4E0" stroke-width="3" stroke-linejoin="round"></path>
        <path d="M19 44 L19 31 L32 44 Z" fill="#E9B0B0" opacity="0.8"></path>
        <circle cx="46" cy="22" r="9" fill="#8F2F2F"></circle>
        <circle cx="46" cy="22" r="4.2" fill="#F2B6B6"></circle>
        <circle cx="43.4" cy="19.2" r="2.2" fill="#fff" opacity="0.55"></circle>
      </>
    )}

    {name === 'code' && (
      <>
        <rect x="8" y="12" width="48" height="36" rx="8" fill={`url(#${id}-ink)`}></rect>
        <circle cx="16" cy="19" r="2.1" fill="#FF8F7A"></circle>
        <circle cx="22.5" cy="19" r="2.1" fill="#FFD36B"></circle>
        <circle cx="29" cy="19" r="2.1" fill="#8FD98F"></circle>
        <path d="M24 30 L17 35 L24 40" stroke="#BFD6FF" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
        <path d="M40 30 L47 35 L40 40" stroke="#BFD6FF" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
        <path d="M34.5 28 L29.5 42" stroke="#FFE2A3" stroke-width="3" stroke-linecap="round"></path>
        <rect x="22" y="50" width="20" height="5" rx="2.5" fill="#FFF4E0"></rect>
      </>
    )}

    {name === 'data' && (
      <>
        <rect x="10" y="34" width="12" height="20" rx="5" fill="#FFF4E0"></rect>
        <rect x="26" y="20" width="12" height="34" rx="5" fill="#FFF4E0"></rect>
        <rect x="42" y="10" width="12" height="44" rx="5" fill="#7A4A00"></rect>
        <rect x="12" y="36" width="3.2" height="12" rx="1.6" fill="#fff" opacity="0.7"></rect>
        <rect x="28" y="22" width="3.2" height="22" rx="1.6" fill="#fff" opacity="0.7"></rect>
        <rect x="44" y="12" width="3.2" height="28" rx="1.6" fill="#fff" opacity="0.35"></rect>
      </>
    )}
  </g>
</svg>

<style>
  .course-icon {
    display: block;
    flex: none;
  }
</style>
